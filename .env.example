# Frontend and backend remain separate local projects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
POLICY_API_URL=http://127.0.0.1:8000
# Server-only: set this to the backend ADMIN_API_KEY; never prefix NEXT_PUBLIC_.
POLICY_ADMIN_API_KEY=replace-with-backend-admin-key
POLICY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POLICY_API_TIMEOUT_MS=90000
